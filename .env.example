# =============================================================================
# Local development — copy to backend/.env (Django loads backend/.env)
# Render production — set these in Render Dashboard → Environment
# =============================================================================

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,hello-ats-ai.onrender.com

# CORS — comma-separated frontend origins (exact URLs, no spaces)
# Local:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production (Render) — add your Vercel URL(s), e.g.:
# CORS_ALLOWED_ORIGINS=https://hello-ats-ai.vercel.app,https://your-preview-name.vercel.app

# Optional: allow all Vercel preview + production URLs (default in settings.py if unset)
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# Upload limits
MAX_RESUME_UPLOAD_SIZE_MB=5

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
MAX_RESUME_TEXT_CHARS=30000

# =============================================================================
# Vercel (frontend) — set in Vercel Dashboard → Environment Variables
# =============================================================================
# VITE_API_BASE_URL=https://hello-ats-ai.onrender.com

# =============================================================================
# Render production checklist
# =============================================================================
# DJANGO_SECRET_KEY=...          (required; SECRET_KEY also works as alias)
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=hello-ats-ai.onrender.com
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# CORS_ALLOWED_ORIGINS=https://hello-ats-ai.vercel.app
